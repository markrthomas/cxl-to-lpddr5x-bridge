# .claude/swarm.env — this repo's profile for the shared DV swarm kit (markrthomas/dv-swarm-kit).
# See the kit's templates/swarm.env.example for what each key means. Environment variables override these.

PROJECT=cxl-to-lpddr5x-bridge
GH_REPO=markrthomas/cxl-to-lpddr5x-bridge
DUT_TOP=cxl_lpddr5x_bridge

RTL_DIR=src
TB_DIR=verification

DV_ENVS="sim cocotb uvm"
GATE_TARGET=check
CI_TARGET=ci
CROSSCHECK_TARGET=
INFRA_TARGETS="sva formal synth cdc perf"
HEAVY_TARGETS="uvm coverage formal synth ci"

MUTATION_FILE=src/cxl_lpddr5x_bridge.v
MUTATION_HINT="invert one valid/ready qualifier or corrupt one data bit on the main datapath"

RR_DIR=verification/random
RR_STATUS=bootstrap

METRICS=no
